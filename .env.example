# DocGuard AI — environment configuration template
# Copy to .env and fill in values as needed for each research phase.

# ---------------------------------------------------------------------------
# Project paths
# ---------------------------------------------------------------------------
PROJECT_ROOT=.
DATA_DIR=./data
MODELS_DIR=./models
CONFIGS_DIR=./configs
EXPERIMENTS_DIR=./experiments

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Experiment tracking (future phases — uncomment when configured)
# ---------------------------------------------------------------------------
# MLFLOW_TRACKING_URI=./mlruns
# WANDB_PROJECT=docguard-ai
# WANDB_API_KEY=

# ---------------------------------------------------------------------------
# Model and API keys (future phases — do not commit real values)
# ---------------------------------------------------------------------------
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_DEVICE=cpu
VLM_MAX_NEW_TOKENS=512
VLM_DTYPE=float32
